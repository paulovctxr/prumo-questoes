{"id":1272022,"topic":"Funções","sub":"Quadrática","difficulty":"Não classificada","text":"Sejam $a$, $b$ e $c$ constantes reais, com $a\\ne0$, formando, nessa ordem, uma progressão aritmética. A soma das raízes de $ax^2+bx+c=0$ é $-\\sqrt2$. Qual relação entre $b$ e $c$ é válida?","options":["$c=\\frac{b}{\\sqrt2}(\\sqrt2-1)$","$c=b(2-\\sqrt2)$","$c=b(\\sqrt2-1)$","$c=b\\sqrt2$","$c=\\frac b2(4-\\sqrt2)$"],"answer":null,"steps":[],"type":"Múltipla escolha","institution":"Tópicos de Álgebra Elementar","exam":"Tópicos de Álgebra Elementar","year":null,"solution":"Pendente","solutionNote":"","answerText":"","bookOriginal":true,"transcribed":true,"source":{"name":"Tópicos de Álgebra Elementar","page":297,"number":22,"chapter":"Função do segundo grau","publicationYear":2021,"bookKey":"272:22"},"contentVersion":"9b7c6c1c4f9eaec9"}
