{"id":1037004,"topic":"Equações, inequações e sistemas","sub":"Módulo de um número real","difficulty":"Não classificada","text":"4) Determine a solução da equação 3 x - 9 - 3 = 6","options":[],"answer":null,"steps":["$|3x-9|-3=6$ equivale a $|3x-9|=9$.","Assim, $3x-9=9$ ou $3x-9=-9$. Resultam $x=6$ e $x=0$. Ambos produzem $9-3=6$ na equação original."],"type":"Discursiva","institution":"Tópicos de Álgebra Elementar","exam":"Tópicos de Álgebra Elementar","year":null,"solution":"Texto","solutionNote":"","answerText":"{0, 6}","bookOriginal":true,"bookImages":[{"src":"livro-algebra/q-37-4-0.webp","width":904,"height":54}],"bookAnswerImages":[{"page":46,"src":"livro-algebra/answers-46.webp","width":904,"height":1228},{"page":47,"src":"livro-algebra/answers-47.webp","width":904,"height":448}],"source":{"name":"Tópicos de Álgebra Elementar","page":41,"number":4,"chapter":"Módulo de um número real","publicationYear":2021,"bookKey":"37:4"},"contentVersion":"172a8d982564de72"}
